+		n := wf.Status.Nodes[wf.Name]
+		n.TaskResultSynced = nil
+		wf.Status.Nodes[wf.Name] = n
+		wf.Status.TaskResultsCompletionStatus = map[string]bool{wf.Name: true}
+		_, err := legacySuccessfulNode(wf, pod)
+		require.NoError(t, err)
+	})
